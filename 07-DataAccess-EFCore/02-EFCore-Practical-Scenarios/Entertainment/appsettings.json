{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "System": "Warning"
    }
  },

  "ConnectionStrings": {
    "EntertainmentDb": "Data Source=entertainment.db"
  },

  "EntertainmentSettings": {
    "DatabaseInitialization": {
      "AutoMigrate": true,
      "DeleteOnShutdown": true
    }
  },

  "Features": {
    "ShowBoxOffice": true,
    "MaxResultsPerPage": 50,
    "EnableCaching": true,
    "CacheExpirationSeconds": 300
  },

  "AllowedHosts": "*"
}